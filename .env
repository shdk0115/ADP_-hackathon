# ── AWS Bedrock ─────────────────────────────────────
AWS_REGION=us-east-1

# LLM (텍스트 생성)
BEDROCK_LLM_MODEL=us.anthropic.claude-sonnet-4-6

# 임베딩
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# ── OpenSearch ──────────────────────────────────────
OPENSEARCH_HOST=search-air-demo-dvxpk44mlk574r2afkm27cn33u.us-east-1.es.amazonaws.com
OPENSEARCH_PORT=443
OPENSEARCH_USE_SSL=true
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=Admin1234!

# ── 파이프라인 설정 ─────────────────────────────────
TARGET_SCORE=95
MAX_PIPELINE_RETRY=3
MAX_ANALYSIS_RETRY=2
